# Optional: override the bundled country-reference snapshot at runtime.
# Return either a flat array of country records or `{ "countries": [...] }`.
# CORS must allow the app origin. Responses are cached for seven days.
# VITE_COUNTRY_DATA_URL=https://example.com/countries.json

# Optional: override the Natural Earth boundary GeoJSON endpoint.
# VITE_COUNTRY_GEOJSON_URL=https://example.com/countries.geojson
