{
  "name": "world-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An interactive political world atlas built on a 3D globe.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "data:build": "node scripts/build-country-data.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "globe.gl": "^2.46.2",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
